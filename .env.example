# Application Settings
APP_NAME=webhook-delivery-service
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-super-secret-key-change-this

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webhooks
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/webhooks
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/webhooks

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=600  # 10 minutes in seconds

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Webhook Settings
WEBHOOK_TIMEOUT=10  # seconds
MAX_RETRY_ATTEMPTS=5
RETRY_DELAYS=10,30,60,300,900  # seconds (10s, 30s, 1m, 5m, 15m)
LOG_RETENTION_HOURS=72

# API Documentation
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS Settings
CORS_ORIGINS=http://localhost:8000,http://localhost:3000